# Local Netlify folder
.netlify
.DS_Store
Thumbs.db
__MACOSX/
lh-*.json

# Versoes antigas guardadas em disco, nao vao para o site
_backup_*/

# Imoveis: dados e fotos descem do Netlify Blobs no build (plugins/imoveis-blobs)
# e as fichas sao geradas por scripts/gerar-imoveis.mjs. Nada disso vai pro git.
imoveis/*/
imoveis/_dados/*
imoveis/fotos/*
!imoveis/_dados/.gitkeep
!imoveis/fotos/.gitkeep

# Dependencias da funcao do painel de imoveis
node_modules/
deno.lock
